<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/ic_back"
        android:contentDescription="Kembali"
        android:elevation="2dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin - WiFi Fingerprinting"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <EditText
            android:id="@+id/etLocationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Lokasi (contoh: Ruang A)"
            android:textColorHint="@color/black"
            android:background="@drawable/edittext_bg"
            android:padding="15dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/black"/>


        <Button
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan WiFi"
            android:backgroundTint="@color/blue"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnToFingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kelola Data Fingerprint"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/blue"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/btnToMapping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kelola Mapping Koordinat"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/blue"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear List"
            android:backgroundTint="@color/red"
            android:textColor="@color/white"
            android:textAllCaps="false"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hasil Scan WiFi"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Empty state -->
        <TextView
            android:id="@+id/emptyWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada hasil scan.\nTekan 'Scan WiFi' untuk mulai."
            android:gravity="center"
            android:padding="16dp"
            android:textColor="#666666"
            android:visibility="gone"
            android:layout_marginBottom="6dp"/>

        <ListView
            android:id="@+id/wifiListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:listSelector="?attr/selectableItemBackground"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:clipToPadding="false" />
    </LinearLayout>

</LinearLayout>
